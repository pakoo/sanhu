{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sanhu-attach",
      "url": "http://localhost:8000",
      "port": 8000
    },
    {
      "name": "sanhu",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/sanhu"
      ],
      "port": 8000
    },
    {
      "name": "sanhu-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SANHU_PORT=8123 go run ./cmd/sanhu"
      ],
      "port": 8123
    }
  ]
}
